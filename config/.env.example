# API Keys — copy this file to config/.env and fill in values.
# NEVER commit config/.env to git.

# Anthropic (Claude) — for research synthesis, script gen, metadata
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_OPUS_MODEL=claude-opus-4-8

# YouTube OAuth uses youtube-mcp/.secrets/client_secret.json and token.json.

# Optional: SerpAPI — for Google Scholar/academic search
# SERP_API_KEY=

# Optional: Perplexity API — for deep web research
# PERPLEXITY_API_KEY=
