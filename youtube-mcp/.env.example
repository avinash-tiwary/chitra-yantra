# ==============================================================================
# YouTube MCP Server - Environment Configuration
# ==============================================================================

# Path to the OAuth 2.0 Client Secret JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRET_PATH="./.secrets/client_secret.json"

# Path where the authenticated user token (refresh token) will be stored.
YOUTUBE_TOKEN_PATH="./.secrets/token.json"

# Default video category for uploads
# Common categories:
#   27 = Education
#   28 = Science & Technology
#   22 = People & Blogs
#   24 = Entertainment
#   20 = Gaming
YOUTUBE_DEFAULT_CATEGORY_ID="27"

# Default upload privacy status
# Allowed: "private", "unlisted", "public"
# Recommended: "private" or "unlisted" for automated workflows
YOUTUBE_DEFAULT_PRIVACY="private"

# Port to use for the local OAuth authorization callback (0 = automatic free port)
YOUTUBE_AUTH_PORT="0"
